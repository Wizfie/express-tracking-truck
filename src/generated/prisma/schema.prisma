generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id               Int       @id @default(autoincrement())
  username         String    @unique
  password         String
  phone            String?
  email            String?
  role             Role      @default(USER)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  trips            Trip[]
  company          String? // Relasi ke Vehicle
  sentMessages     Message[] @relation("Sender")
  receivedMessages Message[] @relation("Receiver")
}

enum Role {
  ADMIN
  USER
}

enum Status {
  ACTIVE
  FINISH
}

model Vehicle {
  id         Int    @id @default(autoincrement())
  platNumber String @unique
  brand      String
  company    String
  type       String
  trips      Trip[]
}

model Trip {
  id        Int        @id @default(autoincrement())
  startTime DateTime   @default(now())
  endTime   DateTime?
  soNumber  String?
  userId    Int
  status    Status     @default(ACTIVE)
  user      User       @relation(fields: [userId], references: [id])
  vehicleId Int // Menambahkan field untuk relasi dengan Vehicle
  location  Location[]
  vehicle   Vehicle    @relation(fields: [vehicleId], references: [id]) // Relasi dengan Vehicle
}

model Location {
  id         Int      @id @default(autoincrement())
  latitude   Float
  longitude  Float
  timeStamp  DateTime @default(now())
  tripId     Int
  trip       Trip     @relation(fields: [tripId], references: [id])
  streetName String? // Nama jalan hasil geocoding
  city       String? // Kota hasil geocoding
  state      String? // Provinsi hasil geocoding
}

model Message {
  id         Int      @id @default(autoincrement())
  senderId   Int
  receiverId Int
  content    String
  createdAt  DateTime @default(now())
  sender     User     @relation("Sender", fields: [senderId], references: [id])
  receiver   User     @relation("Receiver", fields: [receiverId], references: [id])
}
